{
  "version": 2,
  "builds": [
    {
      "src": "src/app/vercel.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["src/shared/infrastructure/email/assets/narmer-logo.png"]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "src/app/vercel.js"
    }
  ]
}
