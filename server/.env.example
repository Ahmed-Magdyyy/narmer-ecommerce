NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# A replica set is required for staff/catalog mutations, superAdmin setup/handover, Order placement/status changes and Lead submission/contact marking.
MONGODB_URI=mongodb://127.0.0.1:27017/narmer-ecommerce
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DEFAULT_LOCALE=en
# Set to your exact reverse-proxy hop count when deploying behind a proxy.
TRUST_PROXY=0
# Generate three different random secrets (see README). Do not use these empty values.
JWT_SECRET=
OTP_SECRET=
# Stable private key for coupon phone-use identifiers. Keep it separate; rotation needs a usage-history migration.
COUPON_IDENTITY_SECRET=
# Email can be configured later; OTP requests return 503 until configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional customer emails, enabled per side only when SMTP and that link are configured.
# Frontend must support guest token from fragment and authenticated account reads without a token.
# Examples: https://shop.example/orders/{id}#token={token} and https://business.example/requests/{id}#token={token}
B2C_TRACKING_URL_TEMPLATE=
B2B_TRACKING_URL_TEMPLATE=

# Optional public catalog storage. Use the storage-zone password, not the account API key.
# Configure all three non-endpoint fields together.
BUNNY_PUBLIC_STORAGE_ZONE=
BUNNY_PUBLIC_ACCESS_KEY=
BUNNY_PUBLIC_STORAGE_ENDPOINT=https://storage.bunnycdn.com
BUNNY_PUBLIC_CDN_ORIGIN=

# Optional private transfer-proof and B2B Lead-image storage. Use a separate zone with NO public pull-zone access.
# These legacy PROOF names configure both private namespaces. Reads require backend authorization, never a public CDN URL.
BUNNY_PROOF_STORAGE_ZONE=
BUNNY_PROOF_ACCESS_KEY=
BUNNY_PROOF_STORAGE_ENDPOINT=https://storage.bunnycdn.com
