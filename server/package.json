{
  "name": "narmer-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/app/server.js",
    "start": "node --env-file-if-exists=.env src/app/server.js",
    "test": "node --test tests/*.test.js",
    "backfill:wholesale-slugs": "node --env-file-if-exists=.env scripts/backfill-wholesale-slugs.js",
    "test:db:wholesale": "node --env-file-if-exists=.env scripts/test-development-db.js --wholesale-only",
    "docs:frontend": "node scripts/build-frontend-docs.js",
    "docs:frontend:check": "node scripts/build-frontend-docs.js --check"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.1",
    "nodemailer": "^10.1.0",
    "sharp": "^0.35.5"
  }
}
